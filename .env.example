DATABASE_URL=file:./data/suanming.db
DATABASE_DIALECT=sqlite
ADMIN_USERNAME=admin
# 生产必须改成强密码；默认 admin123 仅开发
ADMIN_PASSWORD=admin123
# 生产必须换成 ≥16 位随机串；禁止使用 change-me-in-production / dev-secret
JWT_SECRET=change-me-in-production
# 生产弱密钥时若设 STRICT_PROD_SECRETS=true，ensureSeeded 将直接抛错拒绝启动
# STRICT_PROD_SECRETS=true
# 用户 Cookie Secure：生产默认开启；本地 HTTPS 可 AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SECURE=true
NEXT_PUBLIC_SITE_NAME=易道命理
NEXT_PUBLIC_SITE_URL=https://你的域名.com
NEXT_PUBLIC_SITE_DESCRIPTION=八字、紫微、易经六爻、黄历合婚等三十一门术数

# Capacitor App 壳加载的 H5 地址（优先于上面；模拟器本机用 10.0.2.2）
# CAPACITOR_SERVER_URL=http://10.0.2.2:9111

# 微信公众号 JSSDK（可选）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AI Key 加密盐（可选；默认回退 JWT_SECRET）
AI_KEY_SECRET=

# ===== 微信小程序登录 + 虚拟支付（可选；小程序端使用时必配）=====
# 小程序 AppID / AppSecret（mp.weixin.qq.com → 开发管理 → 开发设置）
WX_MINI_APPID=
WX_MINI_SECRET=
# 米大师应用 id（mp 后台 → 平台能力 → 虚拟支付 → 支付基础配置中的 offerId）
WX_MINI_OFFER_ID=
# 现网 AppKey（env=0 正式环境签名用；只能留在服务端，绝不可下发前端）
WX_MINI_APPKEY=
# 沙箱 AppKey（联调用；WX_MINI_PAY_ENV=1 时生效）
# WX_MINI_SANDBOX_APPKEY=
# 支付环境：0 正式 / 1 沙箱
WX_MINI_PAY_ENV=0
# 发货回调严格验签（联调期可不开；上线建议 =1）
# WX_MINI_NOTIFY_STRICT=1
# 充值档位对应的道具 productId（points_60/points_300/points_980）
# 须在米大师后台「道具管理」中创建，单价与 lib/billing/recharge.ts 的 priceFen 完全一致（分）

# 火山方舟 Token Plan（OpenAI 兼容）
VOLC_ARK_API_KEY=
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VOLC_ARK_ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
VOLC_ARK_MODEL=doubao-seed-2.0-mini
# 识图须用 Agent Plan 支持的模型（Seed 2.0 系列支持 image）；勿用 doubao-1.5-vision-pro
VOLC_ARK_VISION_MODEL=doubao-seed-2.0-lite
# 普通用户 AI 次数上限；管理员（role=admin 或下方邮箱）不限
AI_USER_QUOTA=2
AI_UNLIMITED_EMAILS=
AI_UNLIMITED_USER_IDS=
