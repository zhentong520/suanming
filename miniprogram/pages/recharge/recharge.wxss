.page {
  padding: 24rpx;
}

.card {
  background: #fffaf0;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 18, 8, 0.08);
}

.login-hint {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
  color: #6b5c45;
}

.balance-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.balance-label {
  font-size: 26rpx;
  color: #6b5c45;
}

.balance-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #b83a2f;
}

.notice {
  background: #fdf6e3;
  border: 1rpx solid #e2d8c8;
  color: #9a7229;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.pkg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pkg-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffaf0;
  border: 1rpx solid #e2d8c8;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.pkg-card.buying {
  border-color: #b83a2f;
}

.pkg-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pkg-points {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1208;
}

.pkg-bonus {
  font-size: 22rpx;
  color: #9a7229;
}

.pkg-buy {
  background: #b83a2f;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 0 40rpx;
  line-height: 72rpx;
}

.error {
  color: #b83a2f;
  font-size: 26rpx;
  padding: 16rpx 8rpx;
}

.tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 32rpx;
  color: #8a7a5f;
  font-size: 24rpx;
}
