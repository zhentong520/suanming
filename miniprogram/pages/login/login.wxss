.tabs { display: flex; gap: 32rpx; margin-bottom: 12rpx; }
.tab { color: #6b5c45; padding-bottom: 8rpx; }
.tab.on { color: #b83a2f; border-bottom: 4rpx solid #b83a2f; }

.divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #8a7a5f;
  font-size: 24rpx;
  margin: 28rpx 0;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: #e2d8c8;
}

.btn-wechat {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.btn-wechat::after {
  border: none;
}
