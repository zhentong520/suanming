<view class="card">
  <view class="tabs">
    <text class="tab {{mode==='login'?'on':''}}" data-mode="login" bindtap="switchMode">登录</text>
    <text class="tab {{mode==='register'?'on':''}}" data-mode="register" bindtap="switchMode">注册</text>
  </view>
  <label class="label">账号（邮箱或手机）
    <input class="input" value="{{account}}" bindinput="onAccount" placeholder="邮箱或11位手机" />
  </label>
  <label class="label">密码
    <input class="input" password value="{{password}}" bindinput="onPassword" placeholder="至少6位" />
  </label>
  <label wx:if="{{mode==='register'}}" class="label">昵称（可选）
    <input class="input" value="{{displayName}}" bindinput="onName" />
  </label>
  <button class="btn-primary" loading="{{loading}}" bindtap="submit">{{mode==='login'?'登录':'注册'}}</button>
</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
